# Production PostgreSQL (use the Supabase connection URI)
DATABASE_URL=
SUPABASE_DIRECT_URL=
# Optional CA certificate for PostgreSQL
DATABASE_CA_CERT=
APP_URL=

# Generate a long, random, unique secret for each environment.
JWT_SECRET=
ADMIN_PASSWORD_HASH=
# Optional development passcode
ADMIN_PASSWORD=

# Optional Google admin sign-in. Use the same web client ID on both sides.
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_CLIENT_ID=
ADMIN_GMAIL=
ADMIN_EMAIL=

# Garage SMTP and notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Pit Stop Car Hire
ADMIN_NOTIFICATION_EMAIL=
