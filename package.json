{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --port 3000",
    "dev:server": "node api/index.js",
    "dev:3000": "vite --port 3000",
    "dev:5173": "vite --port 5173",
    "server": "node api/index.js",
    "build:api": "rolldown server/index.ts --file api/index.js --format esm --platform node --external node:sqlite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:selenium": "python -m pytest tests/selenium",
    "test:selenium:watch": "python -m pytest tests/selenium --slowmo 400",
    "test:selenium:turbo": "python -m pytest tests/selenium --slowmo 0",
    "test:selenium:headless": "python -m pytest tests/selenium --headless --slowmo 0",
    "test:auth": "playwright test e2e/auth_session_invalidation.spec.ts",
    "test:fsm": "playwright test e2e/fsm_booking_lifecycle.spec.ts",
    "format": "oxfmt src server scripts"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
